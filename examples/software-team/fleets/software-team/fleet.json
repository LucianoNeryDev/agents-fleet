{
  "$schema": "../../../../schemas/fleet-v1.schema.json",
  "version": 1,
  "id": "software-team",
  "name": "Software team",
  "description": "Illustrative fleet for a small software delivery team. Model IDs live in the shared line catalog and are examples, not bundled providers.",
  "defaultAgent": "build",
  "defaultLine": "$frontier",
  "agents": {
    "build": { "enabled": true, "line": "$frontier", "mode": "primary", "description": "Coordinates implementation work.", "prompt": { "mode": "replace", "paths": ["prompts/build.md"] }, "contextSourceIDs": ["build-memory"] },
    "coder": { "enabled": true, "line": "$standard", "mode": "subagent", "description": "Writes focused code changes.", "prompt": { "mode": "replace", "paths": ["prompts/coder.md"] }, "contextSourceIDs": ["coder-memory"] },
    "reviewer": { "enabled": true, "line": "$economy", "mode": "subagent", "description": "Reviews changes for correctness and maintainability.", "prompt": { "mode": "replace", "paths": ["prompts/reviewer.md"] }, "contextSourceIDs": ["reviewer-memory"] }
  },
  "contextSources": {
    "build-memory": { "ownerAgentID": "build", "path": "memory/build.md", "required": false, "heading": "Team build notes", "maxBytes": 12000 },
    "coder-memory": { "ownerAgentID": "coder", "path": "memory/coder.md", "required": false, "heading": "Coder notes", "maxBytes": 12000 },
    "reviewer-memory": { "ownerAgentID": "reviewer", "path": "memory/reviewer.md", "required": false, "heading": "Reviewer notes", "maxBytes": 12000 }
  }
}
