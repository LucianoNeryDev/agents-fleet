{
  "name": "agents-fleet",
  "version": "0.1.0-dev.0",
  "description": "Validated OpenCode V2 agent architectures and model fleets",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Luciano Nery <luciano@lucianonery.dev>",
  "repository": {
    "type": "git",
    "url": "https://git.lucianonery.dev/LucianoNeryDev/agents-fleet"
  },
  "homepage": "https://lucianonery.dev",
  "bugs": {
    "url": "https://git.lucianonery.dev/LucianoNeryDev/agents-fleet/issues"
  },
  "bin": {
    "agents-fleet": "./dist/cli.js"
  },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./plugin": { "types": "./dist/plugin.d.ts", "import": "./dist/plugin.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "schemas", "examples"],
  "engines": {"node": "^22.22.2 || ^24.15.0 || >=26.0.0"},
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test dist/test/*.test.js",
    "validate:examples": "npm run build && node dist/validate-examples.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-dev-202609161816"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
