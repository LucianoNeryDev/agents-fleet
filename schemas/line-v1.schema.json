{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git.lucianonery.dev/LucianoNeryDev/agents-fleet/raw/branch/master/schemas/line-v1.schema.json",
  "title": "agents-fleet line v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "id", "name", "description", "chain"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "chain": { "type": "array", "minItems": 1, "items": { "$ref": "model-ref.schema.json" } }
  }
}
